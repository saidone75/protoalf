<?xml version='1.0' encoding='UTF-8'?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <bean id="protoalf.server" class="org.saidone.protoalf.platform.GrpcServer" init-method="start" destroy-method="stop">
        <constructor-arg ref="ServiceRegistry"/>
        <!-- Text extraction for GetContent (local transforms, see local.transform.service.enabled) -->
        <constructor-arg ref="synchronousTransformClient"/>
        <!-- Trashcan listing and purge (NodeArchiveService) -->
        <constructor-arg ref="nodeArchiveService"/>
        <constructor-arg value="${protoalf.enabled}"/>
        <constructor-arg value="${protoalf.host}"/>
        <constructor-arg value="${protoalf.port}"/>
        <constructor-arg value="${protoalf.threads}"/>
        <constructor-arg value="${protoalf.max-message-size}"/>
        <constructor-arg value="${protoalf.tls.certificate}"/>
        <constructor-arg value="${protoalf.tls.private-key}"/>
    </bean>

</beans>
